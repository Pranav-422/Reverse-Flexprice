#!/usr/bin/env bash
# Browser view of the differentiator (invoice explainer + spike alert).
# Usage: ./scripts/ui
set -euo pipefail
cd "$(dirname "$0")/.."

if [ -x "./venv/bin/python" ]; then
  PY="./venv/bin/python"
else
  PY="$(command -v python3 || command -v python)"
fi

exec "$PY" scripts/ui.py "$@"
