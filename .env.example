# ---------------------------------------------------------------------------
# Core Billing Engine -- example environment.
# Copy to .env and edit:  cp .env.example .env
# NO REAL SECRETS ARE STORED IN THIS FILE. .env itself is gitignored.
# Variable names come from docs/ARCHITECTURE.md section 7.
# ---------------------------------------------------------------------------

# SQLite database connection string. Use a path under the repo for local runs.
DATABASE_URL=sqlite:///./billing.db

# Injectable server clock (ISO-8601 UTC). Leave EMPTY to use the real system
# time. Set it to freeze "now", which is how a 30-day cycle and a mid-month
# upgrade are simulated in milliseconds instead of waiting a month.
#   example: BILLING_NOW=2026-04-16T00:00:00Z
BILLING_NOW=

# Billing period length override for demos/tests, in minutes.
# 0 (default) = standard one-calendar-month cycles.
# e.g. 2 = a full billing cycle completes in two minutes.
BILLING_PERIOD_MINUTES=0

# OPTIONAL. API key for the AI invoice explainer (docs/GAPS.md Improvement 2).
# LEAVE THIS EMPTY AND THE APP STILL RUNS: the explainer falls back to a
# deterministic local template and /v1/invoices/{id}/explanation keeps
# returning 200 OK. Never commit a real key.
AI_PROVIDER_API_KEY=

# Model used only when AI_PROVIDER_API_KEY is set (Anthropic Claude).
AI_MODEL=claude-opus-5

# Usage-spike detector: flag when 1-hour velocity exceeds this multiple of the
# 7-day hourly average (docs/GAPS.md Improvement 2).
SPIKE_THRESHOLD_FACTOR=3.0

# Event timestamp drift bounds enforced by POST /v1/events (docs/API.md 4).
MAX_PAST_DRIFT_DAYS=30
MAX_FUTURE_DRIFT_MINUTES=5

# Multi-tenant partition key used when a request sends no X-Tenant-ID header.
TENANT_ID=tenant_default
